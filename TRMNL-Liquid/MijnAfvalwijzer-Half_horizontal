{% comment %}Bereken huidige datum en filter komende 5 ophaaldagen{% endcomment %}
{% assign vandaag_timestamp = "now" | date: "%s" %}

<div class="layout layout--col gap--space-between">
  <!-- CODE VOOR VOLGENDE OPHAALDAG -->
 {% if response != 'NOK' and ophaaldagen.response != 'NOK' %}
  <div class="grid">
    <div class="item col--span-8 items--start" style="overflow: visible;">
      <div class="meta"></div>
       <div class="content" style="overflow: visible; padding-bottom: 1.25rem; line-height: 1.2;">
        <span class="label">Volgende ophaaldag</span>
        {% assign teller_1 = 0 %}
        {% for ophaaldag in ophaaldagen.data %}
          {% assign ophaaldag_timestamp = ophaaldag.date | date: "%s" %}
          {% if ophaaldag_timestamp >= vandaag_timestamp and teller_1 == 0 %}
            {% assign dag_nummer = ophaaldag.date | date: "%w" %}
            {% assign maand_nummer = ophaaldag.date | date: "%m" %}
            {% case dag_nummer %}
              {% when "0" %}{% assign dag_naam = "Zondag" %}
              {% when "1" %}{% assign dag_naam = "Maandag" %}
              {% when "2" %}{% assign dag_naam = "Dinsdag" %}
              {% when "3" %}{% assign dag_naam = "Woensdag" %}
              {% when "4" %}{% assign dag_naam = "Donderdag" %}
              {% when "5" %}{% assign dag_naam = "Vrijdag" %}
              {% when "6" %}{% assign dag_naam = "Zaterdag" %}
            {% endcase %}
            {% case maand_nummer %}
              {% when "01" %}{% assign maand_naam = "januari" %}
              {% when "02" %}{% assign maand_naam = "februari" %}
              {% when "03" %}{% assign maand_naam = "maart" %}
              {% when "04" %}{% assign maand_naam = "april" %}
              {% when "05" %}{% assign maand_naam = "mei" %}
              {% when "06" %}{% assign maand_naam = "juni" %}
              {% when "07" %}{% assign maand_naam = "juli" %}
              {% when "08" %}{% assign maand_naam = "augustus" %}
              {% when "09" %}{% assign maand_naam = "september" %}
              {% when "10" %}{% assign maand_naam = "oktober" %}
              {% when "11" %}{% assign maand_naam = "november" %}
              {% when "12" %}{% assign maand_naam = "december" %}
            {% endcase %}
            <span class="value value--small value--tnums">{{ dag_naam }} {{ ophaaldag.date | date: "%-d" }} {{ maand_naam }} {{ ophaaldag.date | date: "%Y" }}</span>
            <span class="value value--medium" style="line-height: 1.1;" >
              <br>{{ ophaaldag.nameType | capitalize }}
            </span>
            {% assign teller_1 = 1 %}
          {% endif %}
        {% endfor %}
      </div>
    </div>
    <!-- TOON EEN BIJPASSENDE AFBEELDING -->
    <div class="item col--span-4 items--start" style="overflow: visible;">
      <div class="content" style="overflow: visible; line-height: 0.5;">
         {% assign teller_2 = 0 %}
        {% for ophaaldag in ophaaldagen.data %}
          {% assign ophaaldag_timestamp = ophaaldag.date | date: "%s" %}
          {% if ophaaldag_timestamp >= vandaag_timestamp and teller_2 == 0 %}
            <span class="value value--medium">
              {% if ophaaldag.type contains "rest" %}<img class="image image--contain" style="width: auto; height: 140px;" src="https://raw.githubusercontent.com/Toorgedm/TRMNL-MijnAfvalwijzer/refs/heads/main/icons/Container-rest.svg">{% endif %}
              {% if ophaaldag.type contains "gft" %}<img class="image image--contain" style="width: auto; height: 140px;" src="https://raw.githubusercontent.com/Toorgedm/TRMNL-MijnAfvalwijzer/refs/heads/main/icons/Container-gft.svg">{% endif %}
              {% if ophaaldag.type contains "pmd" %}<img class="image image--contain" style="width: auto; height: 140px;" src="https://raw.githubusercontent.com/Toorgedm/TRMNL-MijnAfvalwijzer/refs/heads/main/icons/Container-pmd.svg">{% endif %}
              {% if ophaaldag.type contains "papier" %}<img class="image image--contain" style="width: auto; height: 140px;" src="https://raw.githubusercontent.com/Toorgedm/TRMNL-MijnAfvalwijzer/refs/heads/main/icons/Container-papier.svg">{% endif %}
              {% if ophaaldag.type contains "kerstbomen" %}<img class="image image--contain" style="width: auto; height: 140px;" src="https://raw.githubusercontent.com/Toorgedm/TRMNL-MijnAfvalwijzer/refs/heads/main/icons/Kerstbomen.svg">{% endif %}
            </span>
            {% assign teller_2 = 1 %}
          {% endif %}
        {% endfor %}
      </div>
      <div class="meta"></div>
    </div>
  </div>
  {% else %}

  <!-- GEEN OPHAALDAGEN BESCHIKBAAR, DAN DIT TONEN -->
  <div class="grid">
    <div class="item col--span-12 items--start" style="overflow: visible;">
      <div class="meta"></div>
      <div class="content" style="overflow: visible; padding-bottom: 0.25rem; line-height: 1.2;">
        <span class="label">Helaas</span>
        <span class="value value--small">Geen ophaaldagen gevonden</span>
      </div>
    </div>
  </div>
  {% endif %}
  <div class="w--full b-h-gray-5"></div>
</div>

<!-- TITLE BAR -->
<div class="title_bar">
  <span class="title">
    Ophaaldagen huisvuil: {{ trmnl.plugin_settings.custom_fields_values.strpostcode }} nr. {{ trmnl.plugin_settings.custom_fields_values.inthuisnummer }} {{ trmnl.plugin_settings.custom_fields_values.strHuisnummerToevoeging }}
  </span>
  <span class="instance">
    Bijgewerkt: {{ "now" | date: "%d-%m-%Y" }}
  </span>
</div>